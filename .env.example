# Postgres (Railway in prod; `pnpm db:local` starts a local one on :5544)
DATABASE_URL=postgres://postgres@localhost:5544/park_roulette

# Signs the explorer cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me

# Vercel Blob read/write token for photo + video uploads (vercel env pull)
BLOB_READ_WRITE_TOKEN=

# Public site URL, used for share links and OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000
